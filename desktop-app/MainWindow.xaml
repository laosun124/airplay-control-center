<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AirPlay · Control Center" Width="940" Height="790" MinWidth="810" MinHeight="670" WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBrush}" FontFamily="Segoe UI" FontSize="14" Foreground="{DynamicResource TextBrush}">
 <Window.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3"/>
  <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#606060"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
  <SolidColorBrush x:Key="InputBrush" Color="#FCFCFC"/>
  <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
  <SolidColorBrush x:Key="BadgeBrush" Color="#E5EAF0"/>
  <SolidColorBrush x:Key="IconBrush" Color="#E8F1FB"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#0067C0"/>
  <SolidColorBrush x:Key="AccentTextBrush" Color="White"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#E5F1FB"/>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="12"/><Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource MutedBrush}" Opacity="0.5" CornerRadius="4" Margin="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="After" Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Before" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/><Setter TargetName="After" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="20,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="bd" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,2" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Foreground="{DynamicResource TextBrush}" Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,32,0"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer CanContentScroll="True" MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="28,22,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AirPlay" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Mirror your iPhone, iPad or Mac to this PC" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"><Button x:Name="Theme" Content="Theme: System" Padding="12,6"/><Border Background="{DynamicResource BadgeBrush}" CornerRadius="5" Padding="12,6"><TextBlock Text="v1.0.0" FontSize="12"/></Border></StackPanel></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource IconBrush}" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Top"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="Status" Text="Not running" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="Start the receiver, then select this PC in Screen Mirroring." Style="{StaticResource Hint}" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Start" Content="Start receiver" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}"/><Button x:Name="Stop" Content="Stop" IsEnabled="False" Margin="0"/></StackPanel></Grid></Border>
   <TextBlock Text="Receiver settings" FontWeight="SemiBold" Margin="2,10,0,10"/>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Device name" FontWeight="SemiBold"/><TextBlock Text="Shown in Screen Mirroring on your Apple device" Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><TextBox Grid.Column="1" x:Name="DeviceName" MaxLength="40" AutomationProperties.Name="Device name"/></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Resolution" FontWeight="SemiBold"/><TextBlock Text="Choose a preset or enter width × height. Output is negotiated with your device." Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><StackPanel Grid.Column="1"><ComboBox x:Name="Resolution" AutomationProperties.Name="Resolution preset"><ComboBoxItem Content="1280 × 720 · 720p"/><ComboBoxItem Content="1920 × 1080 · 1080p"/><ComboBoxItem Content="2560 × 1440 · 1440p"/><ComboBoxItem Content="3840 × 2160 · 4K"/><ComboBoxItem Content="Custom"/></ComboBox><StackPanel x:Name="CustomResolution" Orientation="Horizontal" Margin="0,10,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SelectedIndex,ElementName=Resolution}" Value="4"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBox x:Name="VideoWidth" Width="136" MaxLength="4" AutomationProperties.Name="Width"/><TextBlock Text="×" Margin="12,0" VerticalAlignment="Center"/><TextBox x:Name="VideoHeight" Width="136" MaxLength="4" AutomationProperties.Name="Height"/></StackPanel></StackPanel></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Frame rate" FontWeight="SemiBold"/><TextBlock Text="Higher frame rates require more network and processing power" Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="Fps" AutomationProperties.Name="Frame rate"><ComboBoxItem Content="24 fps" Tag="24"/><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="60 fps" Tag="60"/></ComboBox></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Video streaming" FontWeight="SemiBold"/><TextBlock Text="Receive HLS video from supported apps. Screen mirroring works independently." Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <CheckBox x:Name="Hls" Content="Enable HLS playback" VerticalAlignment="Center"/>
    <ToggleButton x:Name="HlsInfo" Width="30" Height="30" Margin="14,0,0,0" ToolTip="About HLS" AutomationProperties.Name="About HLS" Foreground="{DynamicResource TextBrush}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="InfoCircle" CornerRadius="15" BorderBrush="{DynamicResource MutedBrush}" BorderThickness="1" Background="Transparent"><TextBlock Text="i" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InfoCircle" Property="Background" Value="{DynamicResource BadgeBrush}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="InfoCircle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InfoCircle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="InfoCircle" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="HlsHelp" PlacementTarget="{Binding ElementName=HlsInfo}" Placement="Bottom" VerticalOffset="8" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" IsOpen="{Binding IsChecked,ElementName=HlsInfo,Mode=TwoWay}">
     <Border Width="370" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" TextElement.Foreground="{DynamicResource TextBrush}"><StackPanel>
      <TextBlock Text="HLS (HTTP Live Streaming)" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="A video streaming format developed by Apple, used for both live and on-demand video." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock Text="Screen mirroring" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Shows your device's entire screen on this PC, including apps and interactions." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock Text="HLS video streaming" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="A supported app sends a video playback address to the receiver. The PC loads and plays that stream instead of mirroring the whole screen." TextWrapping="Wrap" Margin="0,0,0,14"/>
      <TextBlock Text="Do I need it?" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <TextBlock Text="Leave HLS off if you only mirror your screen. Turn it on for video from supported apps. Compatibility and protected content can affect playback." TextWrapping="Wrap"/>
     </StackPanel></Border>
    </Popup>
   </StackPanel></Grid></Border>
   <Expander Header="Details and logs" Margin="2,8,0,14"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="EnvironmentInfo" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBox x:Name="Log" Height="180" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Activity log"/><Button x:Name="OpenLogs" Content="Open log folder" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="Save" Content="Save settings" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/><TextBlock x:Name="Feedback" Text="Saving while running restarts the receiver." Style="{StaticResource Hint}" VerticalAlignment="Center"/></StackPanel><DockPanel><TextBlock DockPanel.Dock="Right" Margin="16,0,0,0"><Hyperlink x:Name="GitHub" NavigateUri="https://github.com/laosun124/airplay-control-center" Foreground="{DynamicResource AccentBrush}">GitHub</Hyperlink></TextBlock><TextBlock Text="Use the same network → Control Center → Screen Mirroring → select your device. Closing this window stops the receiver." Style="{StaticResource Hint}"/></DockPanel></StackPanel>
 </Grid>
</Window>
