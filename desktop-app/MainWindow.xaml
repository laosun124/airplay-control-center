<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AirPlay · Control Center" Width="940" Height="790" MinWidth="810" MinHeight="670" WindowStartupLocation="CenterScreen" Background="#F3F3F3" FontFamily="Segoe UI" FontSize="14" Foreground="#1B1B1B">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Padding" Value="20,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D8D8D8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#0067C0"/><Setter TargetName="bd" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="#D0D0D0"/><Setter Property="Background" Value="#FCFCFC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,2" CornerRadius="5"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#0067C0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="36"/><Setter Property="Background" Value="#FCFCFC"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#FCFCFC" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="5"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,32,0"/><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="White" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="5" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer CanContentScroll="True" MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="10,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="BorderBrush" Value="#E5E5E5"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#606060"/><Setter Property="FontSize" Value="12"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Window.Resources>
 <Grid Margin="28,22,28,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="AirPlay" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Mirror your iPhone, iPad or Mac to this PC" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="1" Background="#E5EAF0" CornerRadius="5" Padding="12,6" VerticalAlignment="Top"><TextBlock Text="v1.1.1 · MSE" FontSize="12"/></Border></Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#E8F1FB" CornerRadius="10" Width="44" Height="44" VerticalAlignment="Top"><TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="23" Foreground="#0067C0" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock x:Name="Status" Text="Not running" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Text="Start the receiver, then select this PC in Screen Mirroring." Style="{StaticResource Hint}" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="Start" Content="Start receiver" Background="#0067C0" Foreground="White" BorderBrush="#0067C0"/><Button x:Name="Stop" Content="Stop" IsEnabled="False" Margin="0"/></StackPanel></Grid></Border>
   <TextBlock Text="Receiver settings" FontWeight="SemiBold" Margin="2,10,0,10"/>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Device name" FontWeight="SemiBold"/><TextBlock Text="Shown in Screen Mirroring on your Apple device" Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><TextBox Grid.Column="1" x:Name="DeviceName" MaxLength="40" AutomationProperties.Name="Device name"/></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Resolution" FontWeight="SemiBold"/><TextBlock Text="Choose a preset or enter width × height. Output is negotiated with your device." Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><StackPanel Grid.Column="1"><ComboBox x:Name="Resolution" AutomationProperties.Name="Resolution preset"><ComboBoxItem Content="1280 × 720 · 720p"/><ComboBoxItem Content="1920 × 1080 · 1080p"/><ComboBoxItem Content="2560 × 1440 · 1440p"/><ComboBoxItem Content="3840 × 2160 · 4K"/><ComboBoxItem Content="Custom"/></ComboBox><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox x:Name="VideoWidth" Width="136" MaxLength="4" AutomationProperties.Name="Width"/><TextBlock Text="×" Margin="12,0" VerticalAlignment="Center"/><TextBox x:Name="VideoHeight" Width="136" MaxLength="4" AutomationProperties.Name="Height"/></StackPanel></StackPanel></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="Frame rate" FontWeight="SemiBold"/><TextBlock Text="Higher frame rates require more network and processing power" Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="Fps" AutomationProperties.Name="Frame rate"><ComboBoxItem Content="24 fps" Tag="24"/><ComboBoxItem Content="30 fps" Tag="30"/><ComboBoxItem Content="60 fps" Tag="60"/></ComboBox></Grid></Border>
   <Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Video streaming" FontWeight="SemiBold"/><TextBlock Text="Receive HLS video from supported apps. Screen mirroring works independently." Style="{StaticResource Hint}" Margin="0,5,12,0"/></StackPanel><CheckBox Grid.Column="1" x:Name="Hls" Content="Enable HLS playback" VerticalAlignment="Center"/></Grid></Border>
   <Expander Header="Details and logs" Margin="2,8,0,14"><StackPanel Margin="0,12,0,0"><TextBlock x:Name="EnvironmentInfo" Style="{StaticResource Hint}" Margin="0,0,0,10"/><TextBox x:Name="Log" Height="180" IsReadOnly="True" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" AutomationProperties.Name="Activity log"/><Button x:Name="OpenLogs" Content="Open log folder" HorizontalAlignment="Left" Margin="0,10,0,0"/></StackPanel></Expander>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="2" Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="Save" Content="Save settings" Background="#0067C0" BorderBrush="#0067C0" Foreground="White"/><TextBlock x:Name="Feedback" Text="Saving while running restarts the receiver." Style="{StaticResource Hint}" VerticalAlignment="Center"/></StackPanel><TextBlock Text="Use the same network → Control Center → Screen Mirroring → select your device. Closing this window stops the receiver." Style="{StaticResource Hint}"/></StackPanel>
 </Grid>
</Window>
